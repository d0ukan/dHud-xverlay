<Window x:Class="DHud.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:DHud.Helpers"
        Title="{h:Loc S.Title}"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}">

    <Border Margin="12" CornerRadius="12" Background="#F21A1B22" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>
            <!-- Başlık çubuğu (sürüklenebilir) -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,12,0,4">
                    <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{h:Loc S.Settings}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,8,8,0" Click="CloseButton_Click" ToolTip="{h:Loc S.Close}" />
            </Grid>

            <!-- Sekmeler -->
            <UniformGrid Columns="4" Margin="12,0">
                <RadioButton x:Name="AppearanceTab" Content="{h:Loc S.Tab.Appearance}" GroupName="Tabs" Style="{StaticResource TabHeader}" IsChecked="True" />
                <RadioButton x:Name="MetricsTab" Content="{h:Loc S.Tab.Metrics}" GroupName="Tabs" Style="{StaticResource TabHeader}" />
                <RadioButton x:Name="BehaviorTab" Content="{h:Loc S.Tab.Behavior}" GroupName="Tabs" Style="{StaticResource TabHeader}" />
                <RadioButton x:Name="AlertsTab" Content="{h:Loc S.Tab.Alerts}" GroupName="Tabs" Style="{StaticResource TabHeader}" />
            </UniformGrid>
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

            <Grid Margin="16,0,16,0">

                <!-- ============ GÖRÜNÜM ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=AppearanceTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{h:Loc S.Layout}" Style="{StaticResource SectionHeader}" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="VerticalLayoutRadio" GroupName="Layout" Content="{h:Loc S.Layout.Vertical}"
                                     Style="{StaticResource DarkRadioButton}" Checked="AppearanceRadio_Checked" />
                        <RadioButton x:Name="HorizontalLayoutRadio" GroupName="Layout" Content="{h:Loc S.Layout.Horizontal}"
                                     Style="{StaticResource DarkRadioButton}" Checked="AppearanceRadio_Checked" />
                    </UniformGrid>
                    <CheckBox x:Name="CompactCheckBox" Content="{h:Loc S.Compact}" Margin="0,8,0,0"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="{h:Loc S.Compact.Hint}" />

                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="{h:Loc S.AlwaysOnTop}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="{h:Loc S.AlwaysOnTop.Hint}" />

                    <TextBlock Text="{h:Loc S.SizeOpacity}" Style="{StaticResource SectionHeader}" />
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" />
                        <TextBlock Text="{h:Loc S.Opacity}" />
                    </DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,8"
                            ValueChanged="Slider_ValueChanged" />

                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}" />
                        <TextBlock Text="{h:Loc S.Size}" />
                    </DockPanel>
                    <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,4"
                            ValueChanged="Slider_ValueChanged" />

                    <TextBlock Text="{h:Loc S.Language}" Style="{StaticResource SectionHeader}" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="EnglishRadio" GroupName="Language" Content="English"
                                     Style="{StaticResource DarkRadioButton}" Checked="LanguageRadio_Checked" />
                        <RadioButton x:Name="TurkishRadio" GroupName="Language" Content="Türkçe"
                                     Style="{StaticResource DarkRadioButton}" Checked="LanguageRadio_Checked" />
                    </UniformGrid>
                </StackPanel>

                <!-- ============ GÖSTERGELER ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=MetricsTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{h:Loc S.CpuGpu}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ShowCpuCheckBox" Content="{h:Loc S.ShowCpu}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowGpuCheckBox" Content="{h:Loc S.ShowGpu}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowUsageCheckBox" Content="{h:Loc S.Usage}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowSparklineCheckBox" Content="{h:Loc S.Sparkline}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowClockCheckBox" Content="{h:Loc S.Clock}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowPowerCheckBox" Content="{h:Loc S.Power}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowVramCheckBox" Content="{h:Loc S.Vram}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <TextBlock Text="{h:Loc S.System}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ShowRamCheckBox" Content="{h:Loc S.Ram}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <TextBlock Text="{h:Loc S.Network}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ShowNetworkCheckBox" Content="{h:Loc S.NetSpeed}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <StackPanel x:Name="NetworkOptionsPanel" Margin="28,0,0,0">
                        <CheckBox x:Name="NetworkInBitsCheckBox" Content="{h:Loc S.NetBits}"
                                  Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    </StackPanel>
                    <CheckBox x:Name="ShowPingCheckBox" Content="{h:Loc S.Ping}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <DockPanel Margin="28,4,0,0">
                        <TextBlock Text="{h:Loc S.Address}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBox x:Name="PingHostTextBox" Padding="6,3" Background="#1AFFFFFF"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="White"
                                 BorderBrush="#40FFFFFF" BorderThickness="1"
                                 LostFocus="PingHostTextBox_LostFocus" PreviewKeyDown="PingHostTextBox_KeyDown" />
                    </DockPanel>

                    <TextBlock Text="{h:Loc S.Refresh}" Style="{StaticResource SectionHeader}" />
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" Text="{h:Loc S.Unit.Sec}" />
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=IntervalSlider, StringFormat={}{0:0.0}}" />
                        <TextBlock Text="{h:Loc S.Interval}" />
                    </DockPanel>
                    <Slider x:Name="IntervalSlider" Minimum="0.5" Maximum="5" SmallChange="0.5" LargeChange="1"
                            TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,4,0,4"
                            ValueChanged="Slider_ValueChanged" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                               Text="{h:Loc S.Interval.Hint}" />
                </StackPanel>

                <!-- ============ DAVRANIŞ ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=BehaviorTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{h:Loc S.Startup}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="StartupCheckBox" Content="{h:Loc S.RunAtStartup}"
                              Style="{StaticResource DarkCheckBox}" Click="StartupCheckBox_Click" />
                    <StackPanel Margin="0,4,0,0">
                        <RadioButton x:Name="TaskSchedulerRadio" GroupName="StartupMethod" Style="{StaticResource DarkRadioButton}"
                                     Content="{h:Loc S.TaskScheduler}" Checked="StartupMethod_Checked" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="{h:Loc S.TaskScheduler.Hint}" />
                        <RadioButton x:Name="RegistryRadio" GroupName="StartupMethod" Style="{StaticResource DarkRadioButton}"
                                     Content="Registry (HKCU\...\Run)" Checked="StartupMethod_Checked" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="{h:Loc S.Registry.Hint}" />
                    </StackPanel>
                    <TextBlock x:Name="StartupStatusText" Style="{StaticResource HintText}" Margin="0,4,0,0" />

                    <TextBlock Text="{h:Loc S.MouseAndPosition}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ClickThroughCheckBox" Content="{h:Loc S.ClickThrough}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="{h:Loc S.ClickThrough.Hint}" />
                    <CheckBox x:Name="LockPositionCheckBox" Content="{h:Loc S.Lock}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="SnapCheckBox" Content="{h:Loc S.Snap}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <TextBlock Text="{h:Loc S.Hotkeys}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="HotkeysCheckBox" Content="{h:Loc S.Hotkeys.Enable}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <Grid Margin="28,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ctrl+Shift+F9" FontFamily="Consolas" Margin="0,0,12,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{h:Loc S.Hotkeys.Toggle}" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Grid.Row="1" Text="Ctrl+Shift+F10" FontFamily="Consolas" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{h:Loc S.Hotkeys.ClickThrough}" Foreground="{StaticResource SubtleTextBrush}" />
                    </Grid>
                    <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource HintText}" Foreground="{StaticResource WarnBrush}" />

                    <TextBlock Text="{h:Loc S.Version}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="AutoUpdateCheckBox" Content="{h:Loc S.AutoUpdate}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <Button Content="{h:Loc S.CheckNow}" Style="{StaticResource DarkButton}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Click="CheckUpdateButton_Click" />
                </StackPanel>

                <!-- ============ UYARILAR ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=AlertsTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{h:Loc S.TempColors}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ColorCheckBox" Content="{h:Loc S.ColorByTemp}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <TextBlock Text="{h:Loc S.Cpu}" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <DockPanel Margin="0,4,0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" Foreground="{StaticResource WarnBrush}"
                                   Text="{Binding Value, ElementName=CpuWarnSlider, StringFormat={}{0:0}°C}" />
                        <TextBlock>
                            <Run Text="●" Foreground="{StaticResource WarnBrush}" />
                            <Run Text="{h:Loc S.WarnThreshold}" />
                        </TextBlock>
                    </DockPanel>
                    <Slider x:Name="CpuWarnSlider" Minimum="30" Maximum="100" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                            ValueChanged="ThresholdSlider_ValueChanged" />

                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" Foreground="{StaticResource HotBrush}"
                                   Text="{Binding Value, ElementName=CpuHotSlider, StringFormat={}{0:0}°C}" />
                        <TextBlock>
                            <Run Text="●" Foreground="{StaticResource HotBrush}" />
                            <Run Text="{h:Loc S.HotThreshold}" />
                        </TextBlock>
                    </DockPanel>
                    <Slider x:Name="CpuHotSlider" Minimum="31" Maximum="110" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                            ValueChanged="ThresholdSlider_ValueChanged" />

                    <TextBlock Text="{h:Loc S.Gpu}" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <DockPanel Margin="0,4,0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" Foreground="{StaticResource WarnBrush}"
                                   Text="{Binding Value, ElementName=GpuWarnSlider, StringFormat={}{0:0}°C}" />
                        <TextBlock>
                            <Run Text="●" Foreground="{StaticResource WarnBrush}" />
                            <Run Text="{h:Loc S.WarnThreshold}" />
                        </TextBlock>
                    </DockPanel>
                    <Slider x:Name="GpuWarnSlider" Minimum="30" Maximum="100" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                            ValueChanged="ThresholdSlider_ValueChanged" />

                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" Foreground="{StaticResource HotBrush}"
                                   Text="{Binding Value, ElementName=GpuHotSlider, StringFormat={}{0:0}°C}" />
                        <TextBlock>
                            <Run Text="●" Foreground="{StaticResource HotBrush}" />
                            <Run Text="{h:Loc S.HotThreshold}" />
                        </TextBlock>
                    </DockPanel>
                    <Slider x:Name="GpuHotSlider" Minimum="31" Maximum="110" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                            ValueChanged="ThresholdSlider_ValueChanged" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0">
                        <Run Text="●" Foreground="{StaticResource GoodBrush}" />
                        <Run Text="{h:Loc S.GreenHint}" />
                    </TextBlock>

                    <TextBlock Text="{h:Loc S.Notification}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="AlertCheckBox" Content="{h:Loc S.AlertEnable}"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock DockPanel.Dock="Right" Text="{h:Loc S.Unit.Sec}" />
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=AlertSecondsSlider, StringFormat={}{0:0}}" />
                        <TextBlock Text="{h:Loc S.AlertSeconds}" />
                    </DockPanel>
                    <Slider x:Name="AlertSecondsSlider" Minimum="3" Maximum="60" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,4"
                            ValueChanged="Slider_ValueChanged" />
                </StackPanel>
            </Grid>

            <!-- Durum (her sekmede görünür) -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="10,8" Margin="16,14,16,0">
                <StackPanel>
                    <TextBlock x:Name="ElevationStatusText" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="DriverStatusText" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                    <TextBlock x:Name="CpuNameText" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock x:Name="GpuNameText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Düğmeler -->
            <DockPanel Margin="16,14,16,16" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{h:Loc S.ExitApp}" Style="{StaticResource DangerButton}"
                        Click="ExitAppButton_Click" />
                <Button DockPanel.Dock="Right" Content="{h:Loc S.Close}" Style="{StaticResource DarkButton}" MinWidth="80"
                        IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
