<Window x:Class="CpuGpuOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dHud - Ayarlar"
        Language="tr-TR"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}">

    <Border Margin="12" CornerRadius="12" Background="#F21A1B22" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>
            <!-- Başlık çubuğu (sürüklenebilir) -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,12,0,4">
                    <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Ayarlar" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,8,8,0" Click="CloseButton_Click" ToolTip="Kapat" />
            </Grid>

            <!-- Sekmeler -->
            <UniformGrid Columns="4" Margin="12,0">
                <RadioButton x:Name="AppearanceTab" Content="Görünüm" GroupName="Tabs" Style="{StaticResource TabHeader}" IsChecked="True" />
                <RadioButton x:Name="MetricsTab" Content="Göstergeler" GroupName="Tabs" Style="{StaticResource TabHeader}" />
                <RadioButton x:Name="BehaviorTab" Content="Davranış" GroupName="Tabs" Style="{StaticResource TabHeader}" />
                <RadioButton x:Name="AlertsTab" Content="Uyarılar" GroupName="Tabs" Style="{StaticResource TabHeader}" />
            </UniformGrid>
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

            <Grid Margin="16,0,16,0">

                <!-- ============ GÖRÜNÜM ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=AppearanceTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="DÜZEN" Style="{StaticResource SectionHeader}" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="VerticalLayoutRadio" GroupName="Layout" Content="Dikey"
                                     Style="{StaticResource DarkRadioButton}" Checked="AppearanceRadio_Checked" />
                        <RadioButton x:Name="HorizontalLayoutRadio" GroupName="Layout" Content="Yatay (tek satır)"
                                     Style="{StaticResource DarkRadioButton}" Checked="AppearanceRadio_Checked" />
                    </UniformGrid>
                    <CheckBox x:Name="CompactCheckBox" Content="Kompakt görünüm" Margin="0,8,0,0"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Daha küçük yazı, dar boşluklar ve kısa birimler (52° gibi)." />

                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Her zaman en üstte göster"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Kapalıyken overlay diğer pencerelerin arkasında kalabilir." />

                    <TextBlock Text="BOYUT VE SAYDAMLIK" Style="{StaticResource SectionHeader}" />
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" />
                        <TextBlock Text="Arka plan opaklığı" />
                    </DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,8"
                            ValueChanged="Slider_ValueChanged" />

                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}" />
                        <TextBlock Text="Boyut" />
                    </DockPanel>
                    <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,4"
                            ValueChanged="Slider_ValueChanged" />
                </StackPanel>

                <!-- ============ GÖSTERGELER ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=MetricsTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="CPU VE GPU" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ShowUsageCheckBox" Content="Kullanım yüzdesi (%)"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowSparklineCheckBox" Content="Mini sıcaklık grafiği (son 60 ölçüm)"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowClockCheckBox" Content="Frekans (GHz / MHz)"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowPowerCheckBox" Content="Güç tüketimi (W)"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="ShowVramCheckBox" Content="GPU bellek kullanımı (VRAM)"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <TextBlock Text="SİSTEM" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ShowRamCheckBox" Content="RAM kullanımı"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <TextBlock Text="AĞ / İNTERNET" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ShowNetworkCheckBox" Content="İndirme / yükleme hızı"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <StackPanel x:Name="NetworkOptionsPanel" Margin="28,0,0,0">
                        <CheckBox x:Name="NetworkInBitsCheckBox" Content="Hızı Mbps olarak göster (yerine MB/s)"
                                  Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                        <CheckBox x:Name="ShowPingCheckBox" Content="Ping (gecikme)"
                                  Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                        <DockPanel Margin="28,4,0,0">
                            <TextBlock Text="Adres" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="PingHostTextBox" Padding="6,3" Background="#1AFFFFFF"
                                     Foreground="{StaticResource TextBrush}" CaretBrush="White"
                                     BorderBrush="#40FFFFFF" BorderThickness="1"
                                     LostFocus="PingHostTextBox_LostFocus" PreviewKeyDown="PingHostTextBox_KeyDown" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="GÜNCELLEME" Style="{StaticResource SectionHeader}" />
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=IntervalSlider, StringFormat={}{0:0.0} sn}" />
                        <TextBlock Text="Okuma aralığı" />
                    </DockPanel>
                    <Slider x:Name="IntervalSlider" Minimum="0.5" Maximum="5" SmallChange="0.5" LargeChange="1"
                            TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,4,0,4"
                            ValueChanged="Slider_ValueChanged" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                               Text="Kısa aralık daha akıcı, uzun aralık daha az işlemci kullanır." />
                </StackPanel>

                <!-- ============ DAVRANIŞ ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=BehaviorTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="StartupCheckBox" Content="Windows başlangıcında çalıştır"
                              Style="{StaticResource DarkCheckBox}" Click="StartupCheckBox_Click" />
                    <StackPanel Margin="0,4,0,0">
                        <RadioButton x:Name="TaskSchedulerRadio" GroupName="StartupMethod" Style="{StaticResource DarkRadioButton}"
                                     Content="Görev Zamanlayıcı (önerilen)" Checked="StartupMethod_Checked" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Oturum açılışında UAC sormadan yönetici olarak başlar. Kaydetmek için yönetici yetkisi gerekir." />
                        <RadioButton x:Name="RegistryRadio" GroupName="StartupMethod" Style="{StaticResource DarkRadioButton}"
                                     Content="Registry (HKCU\...\Run)" Checked="StartupMethod_Checked" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Klasik yöntem. CPU sıcaklığı için her açılışta UAC onayı istenir." />
                    </StackPanel>
                    <TextBlock x:Name="StartupStatusText" Style="{StaticResource HintText}" Margin="0,4,0,0" />

                    <TextBlock Text="FARE VE KONUM" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ClickThroughCheckBox" Content="Tıklama geçirme"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Tıklamalar overlay'den geçip alttaki pencereye (ör. oyuna) gider. Kapatmak için Ctrl+Shift+F10 veya tepsi menüsü." />
                    <CheckBox x:Name="LockPositionCheckBox" Content="Konumu kilitle"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <CheckBox x:Name="SnapCheckBox" Content="Ekran kenarlarına yapıştır"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <TextBlock Text="KISAYOL TUŞLARI" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="HotkeysCheckBox" Content="Kısayol tuşlarını etkinleştir"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <Grid Margin="28,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ctrl+Shift+F9" FontFamily="Consolas" Margin="0,0,12,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Overlay'i gizle / göster" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Grid.Row="1" Text="Ctrl+Shift+F10" FontFamily="Consolas" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Tıklama geçirmeyi aç / kapat" Foreground="{StaticResource SubtleTextBrush}" />
                    </Grid>
                    <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource HintText}" Foreground="{StaticResource WarnBrush}" />

                    <TextBlock Text="SÜRÜM" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="AutoUpdateCheckBox" Content="Açılışta güncellemeleri denetle"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <Button Content="Şimdi denetle" Style="{StaticResource DarkButton}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Click="CheckUpdateButton_Click" />
                </StackPanel>

                <!-- ============ UYARILAR ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=AlertsTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="SICAKLIK RENKLERİ" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ColorCheckBox" Content="Sıcaklığa göre renklendir"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />

                    <DockPanel Margin="0,8,0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" Foreground="{StaticResource WarnBrush}"
                                   Text="{Binding Value, ElementName=WarnSlider, StringFormat={}{0:0}°C}" />
                        <TextBlock>
                            <Run Text="●" Foreground="{StaticResource WarnBrush}" />
                            <Run Text="Uyarı eşiği" />
                        </TextBlock>
                    </DockPanel>
                    <Slider x:Name="WarnSlider" Minimum="30" Maximum="100" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,8"
                            ValueChanged="ThresholdSlider_ValueChanged" />

                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" Foreground="{StaticResource HotBrush}"
                                   Text="{Binding Value, ElementName=HotSlider, StringFormat={}{0:0}°C}" />
                        <TextBlock>
                            <Run Text="●" Foreground="{StaticResource HotBrush}" />
                            <Run Text="Kritik eşik" />
                        </TextBlock>
                    </DockPanel>
                    <Slider x:Name="HotSlider" Minimum="31" Maximum="110" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,4"
                            ValueChanged="ThresholdSlider_ValueChanged" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0">
                        <Run Text="●" Foreground="{StaticResource GoodBrush}" />
                        <Run Text="Uyarı eşiğinin altı yeşil gösterilir." />
                    </TextBlock>

                    <TextBlock Text="BİLDİRİM" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="AlertCheckBox" Content="Kritik sıcaklıkta bildirim göster"
                              Style="{StaticResource DarkCheckBox}" Click="Option_Click" />
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"
                                   Text="{Binding Value, ElementName=AlertSecondsSlider, StringFormat={}{0:0} sn}" />
                        <TextBlock Text="Kritik eşiğin üstünde kalma süresi" />
                    </DockPanel>
                    <Slider x:Name="AlertSecondsSlider" Minimum="3" Maximum="60" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,4"
                            ValueChanged="Slider_ValueChanged" />
                </StackPanel>
            </Grid>

            <!-- Durum (her sekmede görünür) -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="10,8" Margin="16,14,16,0">
                <StackPanel>
                    <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                    <TextBlock x:Name="ElevationStatusText" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="DriverStatusText" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                    <TextBlock x:Name="CpuNameText" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock x:Name="GpuNameText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Düğmeler -->
            <DockPanel Margin="16,14,16,16" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Uygulamadan çık" Style="{StaticResource DangerButton}"
                        Click="ExitAppButton_Click" />
                <Button DockPanel.Dock="Right" Content="Kapat" Style="{StaticResource DarkButton}" MinWidth="80"
                        IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
