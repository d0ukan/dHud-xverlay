<Window x:Class="DHud.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:DHud.Helpers"
        xmlns:local="clr-namespace:DHud"
        Title="{h:Loc F.CurveTitle}"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}">

    <Border Margin="12" CornerRadius="12" Background="#F21A1B22" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="16,12,0,8" VerticalAlignment="Center" />
                <Button Content="&#x2715;" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,8,8,0" Click="CloseButton_Click" />
            </Grid>

            <StackPanel Margin="16,0,16,16">
                <local:CurveEditor x:Name="Editor" Height="290" />
                <TextBlock Text="{h:Loc F.Hint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Text="{h:Loc F.Source}" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CpuSourceRadio" GroupName="Source" Content="CPU" Margin="0,0,16,0"
                                 Style="{StaticResource DarkRadioButton}" Checked="Source_Checked" />
                    <RadioButton x:Name="GpuSourceRadio" GroupName="Source" Content="GPU"
                                 Style="{StaticResource DarkRadioButton}" Checked="Source_Checked" />
                </StackPanel>

                <DockPanel Margin="0,12,0,0">
                    <TextBlock x:Name="MinValueText" DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right" />
                    <TextBlock Text="{h:Loc F.Min}" />
                </DockPanel>
                <Slider x:Name="MinSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                        TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                        ValueChanged="MinSlider_ValueChanged" />

                <TextBlock Text="{h:Loc F.Presets}" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{h:Loc F.PresetQuiet}" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                            Click="PresetQuiet_Click" />
                    <Button Content="{h:Loc F.PresetOptimal}" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                            Click="PresetOptimal_Click" />
                    <Button Content="{h:Loc F.PresetMax}" Style="{StaticResource DarkButton}"
                            Click="PresetMax_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
