<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Sistem tepsisi simgesi (NotifyIcon) için WinForms da kullanılıyor -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- assets/logo.svg logosundan üretilmiş exe simgesi (Gezgin, görev çubuğu, kısayollar). -->
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <AssemblyName>dHud</AssemblyName>
    <RootNamespace>DHud</RootNamespace>
    <Product>dHud</Product>
    <Version>1.0.30</Version>
    <!-- DPI farkındalığı WPF için app.manifest'te tanımlı; WinForms'un bu konudaki uyarısı geçerli değil. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Bellek/CPU: arka plan GC iş parçacığı ve dinamik PGO kapalı; küçük bir tepsi uygulamasına gerekmez. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Yalnızca kullanılan arayüz dillerinin kaynak klasörleri çıktıya girsin (cs, de, fr... klasörleri gelmesin). -->
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release: `dotnet publish -c Release` tek başına tek dosyalık, self-contained .exe üretir → bin\Release\publish\. Normal Release derlemesi bin\Release\net10.0-windows\ altında kalır. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- RID klasörü eklenmesin; mevcut başlangıç kayıtlarındaki yollar bozulmasın. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- .NET Runtime exe'nin içine gömülür: hedef bilgisayarda .NET kurulu olması gerekmez (~150 MB). -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- exe boyutunu yaklaşık yarıya indirir; ilk açılış biraz yavaşlar. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\bin\Release\publish\</PublishDir>
    <DebugType>none</DebugType>
    <!-- Önceden derlenmiş kod: açılışta daha az JIT, daha az bellek ve CPU. Exe birkaç MB büyür. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- GC, yığın parçalanmasını azaltmak için daha sık sıkıştırır (daha az bellek, çok az CPU). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <!-- Mobil uygulama eşleştirme QR kodu (System.Drawing gerektirmeyen PNG üretici) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- LibreHardwareMonitorLib'in bir bağımlılığı Linux için Mono yardımcı DLL'leri getiriyor; Windows'ta kullanılmıyor. -->
  <Target Name="RemoveUnusedNativeFiles" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libMonoPosixHelper.dll;$(PublishDir)MonoPosixHelper.dll" />
  </Target>

  <!-- Android uygulaması aynı depoda ayrı bir projedir; Windows uygulamasına dahil edilmesin. -->
  <ItemGroup>
    <Compile Remove="mobile\**" />
    <EmbeddedResource Remove="mobile\**" />
    <Page Remove="mobile\**" />
    <None Remove="mobile\**" />
  </ItemGroup>

  <!-- WPF ve WinForms tipleri (Application, Point, Color...) çakışmasın diye
       WinForms isim alanları global olarak eklenmiyor; gereken yerde takma adla kullanılıyor. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
