<Window x:Class="DHud.DarkMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dHud"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}">

    <!-- Uygulamanın diğer pencereleriyle aynı koyu cam görünüm: sistem mesaj kutusunun yerine kullanılır. -->
    <Border Margin="12" CornerRadius="12" Background="#F21A1B22" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="16,12,40,8" />
                <Button Content="&#x2715;" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,8,8,0" Click="CloseButton_Click" />
            </Grid>

            <Grid Margin="16,4,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" FontFamily="Segoe UI Symbol" FontSize="30" Margin="0,0,14,0"
                           VerticalAlignment="Top" />
                <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxWidth="420"
                           VerticalAlignment="Center" />
            </Grid>

            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16" />
        </StackPanel>
    </Border>
</Window>
