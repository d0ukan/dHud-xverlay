<Window x:Class="DHud.FanControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:DHud.Helpers"
        Title="{h:Loc F.Title}"
        Width="1000"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}">

    <Border Margin="12" CornerRadius="12" Background="#F21A1B22" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,12,0,8">
                    <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{h:Loc F.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,8,8,0" Click="CloseButton_Click" />
            </Grid>

            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,16,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                    <TextBlock Text="{h:Loc F.Warning}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Foreground="{StaticResource WarnBrush}" />
                    <CheckBox x:Name="EnableCheckBox" Content="{h:Loc F.Enable}" Style="{StaticResource DarkCheckBox}"
                              Margin="0,10,0,0" Click="EnableCheckBox_Click" />
                    <TextBlock x:Name="EmergencyText" Text="{h:Loc F.Emergency}" Foreground="{StaticResource HotBrush}"
                               FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                    <TextBlock x:Name="NoFansText" Text="{h:Loc F.NoFans}" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                    <!-- Tüm fanlara hazır eğri -->
                    <TextBlock Text="{h:Loc F.AllFans}" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{h:Loc F.PresetQuiet}" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                Click="AllQuiet_Click" />
                        <Button Content="{h:Loc F.PresetOptimal}" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                Click="AllOptimal_Click" />
                        <Button Content="{h:Loc F.PresetMax}" Style="{StaticResource DarkButton}"
                                Click="AllMax_Click" />
                        <Button Content="{h:Loc F.TestAll}" Style="{StaticResource DarkButton}" Margin="24,0,0,0"
                                Click="TestAll_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TestAllStatusText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                    <CheckBox x:Name="IncludePumpCheckBox" Content="{h:Loc F.IncludePump}" Style="{StaticResource DarkCheckBox}"
                              Margin="0,8,0,0" />
                    <TextBlock Text="{h:Loc F.AllHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Profiller: tüm fanların ayarı -->
                    <StackPanel Grid.Column="2">
                    <TextBlock Text="{h:Loc F.Profiles}" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{h:Loc F.ProfileSave}" Style="{StaticResource DarkButton}"
                                Margin="8,0,0,0" Click="SaveProfile_Click" />
                        <TextBox x:Name="ProfileNameBox" MaxLength="24" Padding="6,3" Background="#1AFFFFFF"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="White"
                                 BorderBrush="#40FFFFFF" BorderThickness="1" KeyDown="ProfileNameBox_KeyDown" />
                    </DockPanel>
                    <TextBlock x:Name="ProfileStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                    <WrapPanel x:Name="ProfilePanel" Margin="0,6,0,0" />
                    </StackPanel>
                  </Grid>

                    <!-- Tek tek fanlar: ekran genişliğine göre 2-4 sütun -->
                    <UniformGrid x:Name="FanList" Columns="3" Margin="0,14,-8,0" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
