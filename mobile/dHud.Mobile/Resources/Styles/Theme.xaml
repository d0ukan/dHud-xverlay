<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- PC uygulamasındaki (dHud) koyu temanın renkleri -->
    <Color x:Key="BgColor">#FF0B0D12</Color>
    <Color x:Key="CardColor">#FF12151C</Color>
    <Color x:Key="StrokeColor">#FF1F2430</Color>
    <Color x:Key="TextColor">#FFE6E9EF</Color>
    <Color x:Key="SubtleColor">#FF7B8494</Color>
    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="GoodColor">#FF4ADE80</Color>
    <Color x:Key="WarnColor">#FFFACC15</Color>
    <Color x:Key="HotColor">#FFF87171</Color>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource StrokeColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource SubtleColor}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.5" />
    </Style>

    <Style x:Key="BigLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ValueLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource SubtleColor}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="0.8" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource SubtleColor}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="BorderColor" Value="{StaticResource StrokeColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

</ResourceDictionary>
