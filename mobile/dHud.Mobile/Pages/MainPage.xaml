<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dHud.Mobile.Pages.MainPage"
             BackgroundColor="{StaticResource BgColor}"
             xmlns:ui="clr-namespace:dHud.Mobile.Controls"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,12" RowSpacing="10">

        <!-- Üst çubuk -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
            <HorizontalStackLayout x:Name="TitleBox" Spacing="12" VerticalOptions="Center">
                <Label Text="dHud" FontSize="20" FontAttributes="Bold" CharacterSpacing="0.5"
                       TextColor="{StaticResource TextColor}" VerticalOptions="Center" />
                <Border BackgroundColor="{StaticResource CardColor}" Stroke="{StaticResource StrokeColor}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="10,4" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="7">
                        <BoxView x:Name="StatusDot" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 VerticalOptions="Center" Color="{StaticResource SubtleColor}" />
                        <Label x:Name="StatusLabel" FontSize="12" TextColor="{StaticResource SubtleColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
            <Label x:Name="FpsLabel" Grid.Column="1" IsVisible="False" VerticalOptions="Center" Margin="0,0,8,0"
                   FontSize="26" FontAttributes="Bold" TextColor="{StaticResource GoodColor}" />
            <Button x:Name="FullscreenButton" Grid.Column="2" Text="⛶" Style="{StaticResource IconButton}"
                    Clicked="FullscreenButton_Clicked" />
            <Button x:Name="MenuButton" Grid.Column="3" Text="⋮" Style="{StaticResource IconButton}"
                    Clicked="MenuButton_Clicked" />
        </Grid>

        <!-- Güncelleme çubuğu -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border x:Name="AlertBanner" IsVisible="False" Style="{StaticResource CardStyle}" Padding="12,8"
                    BackgroundColor="#4DF87171" Stroke="{StaticResource HotColor}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="AlertLabel" VerticalOptions="Center" TextColor="{StaticResource TextColor}" FontAttributes="Bold" />
                    <Button x:Name="AlertDismissButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            HeightRequest="38" Padding="16,0" Clicked="AlertDismissButton_Clicked" />
                </Grid>
            </Border>

            <Border x:Name="UpdateBanner" IsVisible="False" Style="{StaticResource CardStyle}" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="UpdateLabel" VerticalOptions="Center" TextColor="{StaticResource TextColor}" />
                    <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            HeightRequest="38" Padding="16,0" Clicked="InstallButton_Clicked" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Eşleşme yokken karşılama -->
        <VerticalStackLayout x:Name="EmptyState" Grid.Row="2" IsVisible="False" Spacing="14"
                             VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="420">
            <Label x:Name="EmptyTitle" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"
                   TextColor="{StaticResource TextColor}" />
            <Label x:Name="EmptyText" HorizontalTextAlignment="Center" TextColor="{StaticResource SubtleColor}" />
            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Clicked="ScanButton_Clicked" />
            <Button x:Name="ManualButton" Style="{StaticResource SecondaryButton}" Clicked="ManualButton_Clicked" />
        </VerticalStackLayout>

        <!-- Göstergeler -->
        <ScrollView x:Name="Dashboard" Grid.Row="2">
            <Grid x:Name="Cards" ColumnSpacing="12" RowSpacing="12">

                <!-- CPU -->
                <Border x:Name="CpuCard" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="CPU" Style="{StaticResource TitleLabel}" />
                            <Label x:Name="CpuName" Grid.Column="1" FontSize="12" LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="End" TextColor="{StaticResource SubtleColor}" />
                        </Grid>
                        <Label x:Name="CpuTemp" Text="--°C" Style="{StaticResource BigLabel}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="CpuUsageCaption" Style="{StaticResource CaptionLabel}" />
                            <Label x:Name="CpuLoad" Grid.Column="1" Text="--%" Style="{StaticResource ValueLabel}" FontSize="13" />
                        </Grid>
                        <ui:BarView x:Name="CpuLoadBar" />
                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout>
                                <Label x:Name="CpuClockCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="CpuClock" Text="--" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label x:Name="CpuPowerCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="CpuPower" Text="--" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label x:Name="CpuFanCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="CpuFan" Text="--" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- GPU -->
                <Border x:Name="GpuCard" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="GPU" Style="{StaticResource TitleLabel}" />
                            <Label x:Name="GpuName" Grid.Column="1" FontSize="12" LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="End" TextColor="{StaticResource SubtleColor}" />
                        </Grid>
                        <Label x:Name="GpuTemp" Text="--°C" Style="{StaticResource BigLabel}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="GpuUsageCaption" Style="{StaticResource CaptionLabel}" />
                            <Label x:Name="GpuLoad" Grid.Column="1" Text="--%" Style="{StaticResource ValueLabel}" FontSize="13" />
                        </Grid>
                        <ui:BarView x:Name="GpuLoadBar" />
                        <Grid ColumnDefinitions="*,*,*,*">
                            <VerticalStackLayout>
                                <Label x:Name="GpuClockCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="GpuClock" Text="--" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label x:Name="GpuPowerCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="GpuPower" Text="--" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label x:Name="GpuFanCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="GpuFan" Text="--" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3">
                                <Label x:Name="GpuVramCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="GpuVram" Text="--" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sıcaklık grafiği -->
                <Border x:Name="GraphCard" Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                            <Label x:Name="GraphTitle" Style="{StaticResource TitleLabel}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#3B82F6" VerticalOptions="Center" />
                                <Label x:Name="CpuLegend" Text="CPU" FontSize="12" TextColor="{StaticResource TextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#A78BFA" VerticalOptions="Center" />
                                <Label x:Name="GpuLegend" Text="GPU" FontSize="12" TextColor="{StaticResource TextColor}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <GraphicsView x:Name="Graph" Grid.Row="1" MinimumHeightRequest="120" />
                    </Grid>
                </Border>

                <!-- RAM -->
                <Border x:Name="RamCard" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="RAM" Style="{StaticResource TitleLabel}" />
                        <Label x:Name="RamValue" Text="--" Style="{StaticResource BigLabel}" FontSize="26" />
                        <ui:BarView x:Name="RamBar" />
                    </VerticalStackLayout>
                </Border>

                <!-- Ağ -->
                <Border x:Name="NetCard" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="NET" Style="{StaticResource TitleLabel}" />
                            <Label x:Name="NetName" Grid.Column="1" FontSize="12" LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="End" TextColor="{StaticResource SubtleColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout>
                                <Label x:Name="NetDownCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="NetDown" Text="--" Style="{StaticResource ValueLabel}" FontSize="18" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label x:Name="NetUpCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="NetUp" Text="--" Style="{StaticResource ValueLabel}" FontSize="18" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label x:Name="NetPingCaption" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="NetPing" Text="--" Style="{StaticResource ValueLabel}" FontSize="18" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>

        <!-- Fan sekmesi: yalnızca hazır eğri / profil seçimi -->
        <ScrollView x:Name="FanPage" Grid.Row="2" IsVisible="False">
            <Grid x:Name="FanLayout" ColumnSpacing="12" RowSpacing="12">
                <Border x:Name="ProfileCard" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="ProfileTitle" Style="{StaticResource TitleLabel}" />
                        <Label x:Name="ProfileHint" FontSize="12" TextColor="{StaticResource SubtleColor}" />
                        <FlexLayout x:Name="ProfileRows" Wrap="Wrap" JustifyContent="Start" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="FanCard" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label x:Name="FanTitle" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
                            <Label x:Name="FanEmergency" Grid.Column="1" IsVisible="False" FontSize="12" FontAttributes="Bold"
                                   VerticalOptions="Center" HorizontalTextAlignment="End" LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource HotColor}" />
                        </Grid>
                        <Label x:Name="FanStatusLabel" FontSize="12" TextColor="{StaticResource SubtleColor}" />
                        <VerticalStackLayout x:Name="FanRows" Spacing="2" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <!-- Sekmeler -->
        <Grid x:Name="TabBar" Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="TabPanelButton" Style="{StaticResource PrimaryButton}" HeightRequest="42" Clicked="TabPanelButton_Clicked" />
            <Button x:Name="TabFansButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" HeightRequest="42" Clicked="TabFansButton_Clicked" />
        </Grid>
    </Grid>
</ContentPage>
