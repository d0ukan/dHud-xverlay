<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scan="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             x:Class="dHud.Mobile.Pages.ScanPage"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <scan:CameraView x:Name="Camera" CameraEnabled="False" BarcodeSymbologies="QRCode"
                         OnDetectionFinished="Camera_OnDetectionFinished" />
        <Border VerticalOptions="End" Margin="16,0,16,32" Padding="14,10" BackgroundColor="#CC141418"
                StrokeThickness="0" StrokeShape="RoundRectangle 14">
            <Label x:Name="HintLabel" HorizontalTextAlignment="Center" TextColor="White" />
        </Border>
    </Grid>
</ContentPage>
